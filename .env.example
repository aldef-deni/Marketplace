###############################################################################
# Market ArahInn — contoh konfigurasi
#
# Salin menjadi .env, lalu sesuaikan. Untuk produksi di market.arahinn.com,
# lihat blok "PRODUKSI" pada tiap bagian.
###############################################################################

APP_NAME="Market ArahInn"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# PRODUKSI: APP_ENV=production, APP_DEBUG=false, APP_URL=https://market.arahinn.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# PRODUKSI: LOG_LEVEL=error

#------------------------------------------------------------------------------
# Identitas merek (dibaca config/brand.php)
#------------------------------------------------------------------------------
BRAND_NAMA="Market ArahInn"
BRAND_NAMA_PENDEK="ArahInn"
BRAND_TAGLINE="Belanja Terarah, Belanja Terpercaya"
BRAND_DOMAIN=market.arahinn.com
BRAND_EMAIL=halo@arahinn.com
BRAND_TELEPON="+62 812-0000-0000"
BRAND_WHATSAPP=6281200000000
BRAND_ALAMAT="Indonesia"
BRAND_URL_INDUK=https://arahinn.com

#------------------------------------------------------------------------------
# Basis data — MySQL / MariaDB
#------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marketplace
DB_USERNAME=root
DB_PASSWORD=
# PRODUKSI: gunakan user khusus, bukan root, dan kata sandi yang kuat.

#------------------------------------------------------------------------------
# Sesi & cache
#------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# PRODUKSI: SESSION_DOMAIN=.arahinn.com bila sesi ingin dibagi antar subdomain,
# atau biarkan null agar sesi terkurung di market.arahinn.com saja.
SESSION_SECURE_COOKIE=false
# PRODUKSI: SESSION_SECURE_COOKIE=true (wajib, karena situs dilayani via HTTPS)

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#------------------------------------------------------------------------------
# Surel
#------------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="halo@arahinn.com"
MAIL_FROM_NAME="${APP_NAME}"
# PRODUKSI: MAIL_MAILER=smtp beserta host, port, dan kredensial SMTP ArahInn.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

#------------------------------------------------------------------------------
# Masuk dengan Google (Socialite)
#
# Ambil di Google Cloud Console → APIs & Services → Credentials →
# Create Credentials → OAuth client ID → Web application.
#
# "Authorized redirect URIs" harus sama persis dengan GOOGLE_REDIRECT_URI,
# termasuk skema dan tanpa garis miring di akhir. Kosongkan ketiganya bila
# belum dipakai — tombol Google otomatis disembunyikan.
#
# Lokal    : http://localhost:8000/auth/google/callback
# Produksi : https://market.arahinn.com/auth/google/callback
#------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

VITE_APP_NAME="${APP_NAME}"
